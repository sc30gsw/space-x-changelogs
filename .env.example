# Turso Cloud database URL (`turso db show --url <database>`).
TURSO_DATABASE_URL=
# Database auth token (`turso db tokens create <database>`). Do not commit a real token.
TURSO_AUTH_TOKEN=
# HTTP Basic credentials. Leave both empty to skip auth during development.
# Same-origin CSRF checks are not authentication.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
