{
  "name": "space-x-changelogs",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vp build",
    "preview": "vp preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "deploy": "SERVER_HOST=cloudflare-workers vp build && SERVER_HOST=cloudflare-workers wrangler deploy",
    "typecheck": "tsc --noEmit",
    "format": "vp fmt",
    "lint": "vp lint",
    "dead-code": "fallow dead-code --fail-on-issues",
    "test:e2e": "e2e run",
    "verify:ingest": "tsx scripts/verify-entry-url-identity.ts",
    "verify:lifecycle": "tsx scripts/verify-entry-lifecycle.ts",
    "check:layout": "tsx scripts/check-bulletproof-layout.ts",
    "check:fence": "tsx scripts/check-import-fence.ts",
    "doctor": "npx react-doctor@latest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@formisch/react": "^1.2.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@libsql/client": "^0.18.0",
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/spotlight": "^9.7.4",
    "@mantine/tiptap": "^9.7.4",
    "@tanstack/db": "1.0.0-rc.1.1",
    "@tanstack/query-core": "5.105.0",
    "@tanstack/query-db-collection": "1.5.0",
    "@tanstack/react-db": "1.0.0-rc.1.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@e2e-dev/web": "^0.15.4",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "ai": "^7.0.0",
    "drizzle-kit": "^0.31.11",
    "e2e": "^0.22.0",
    "fallow": "3.38.1",
    "lightningcss": "^1.33.0",
    "nitro": "3.0.261029-rc",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "unplugin": "^2.3.11",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.156.1"
  },
  "packageManager": "pnpm@10.33.0"
}
